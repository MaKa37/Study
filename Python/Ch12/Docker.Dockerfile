# 1. 운영체제 및 언어 환경 격리 (Base Image)
# 실무 관점: 무거운 전체 OS 대신 최소한의 실행 환경만 포함된 'slim' 버전을 사용하여 
# 이미지 용량을 줄이고 보안 취약점 노출을 최소화합니다.
FROM python:3.10-slim

# 2. 작업 디렉토리 지정
# 컨테이너 내부에서 명령어가 실행될 기본 경로를 지정합니다. 
# 루트(/) 디렉토리가 오염되는 것을 방지합니다.
WORKDIR /app

# 3. 의존성 파일 우선 복사 (★ 핵심: 레이어 캐싱 활용)
# 전체 코드를 복사하기 전에 requirements.txt만 먼저 복사합니다.
COPY requirements.txt .

# 4. 패키지 설치
# --no-cache-dir 옵션을 사용하여 설치 시 발생하는 임시 캐시 파일을 삭제해 
# 최종 이미지의 용량을 경량화합니다.
RUN pip install --no-cache-dir -r requirements

# 5. 나머지 소스 코드 복사
# 패키지 설치가 완료된 후, 변경이 잦은 실제 비즈니스 로직(소스 코드)을 복사합니다.
COPY . .

# 6. 통신 포트 명시
# 이 컨테이너가 8000번 포트를 사용한다는 것을 명시하는 '문서화' 역할입니다.
EXPOSE 8000

# 7. 실행 명령 (Entrypoint/Cmd)
# 컨테이너가 켜질 때 단 한 번 실행되는 기본 프로세스입니다.
# 1 컨테이너 = 1 프로세스 원칙에 따라 웹 서버(uvicorn)를 구동합니다.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]